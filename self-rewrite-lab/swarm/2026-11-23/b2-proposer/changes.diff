+                            [("answer.strip()", {"total": 55.0, "cats": {"a": 55, "b": 55}})],
+                            fmt="full", retries=0)
+    assert rows[1]["kept"] and rows[1]["format"] == "full"
+    assert not rows[2]["kept"] and rows[2]["why"] == "no python code block in the reply"
