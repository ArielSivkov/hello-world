+    _, change, mod = apply('```python\n# CHANGE: hebrew prompt\nCONFIG["sys_hebrew"] = True\n'
+                           'SYSTEM_EXTRA = "Be brief."\n```')
+    assert change == "hebrew prompt" and mod.CONFIG["sys_hebrew"] is True and mod.SYSTEM_EXTRA == "Be brief."
