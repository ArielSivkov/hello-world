diff -ruN '--exclude=__pycache__' a/selfloop/selfloop/selfedit.py selfloop/selfloop/selfedit.py
--- a/selfloop/selfloop/selfedit.py	1970-01-01 00:00:00.000000000 +0000
+++ b/selfloop/selfloop/selfedit.py	2026-11-22 23:58:57.425301569 +0000
@@ -0,0 +1,157 @@
+"""Stage 2: self-edits. The model writes the training data for its own next update.
+
+For every document chosen for training, a generator produces a few short texts
+(implications, restatements, question/answer pairs). Each one becomes a Doc with
+the original title and the generated text in place of the abstract, so the
+existing `model.train` trains on P(generated text | title) and the existing
+`model.score` / `stats.gate` judge the result on the unseen next week exactly as
+for raw documents. Nothing here touches the metric or the gate.
+
+Generators are pluggable:
+  fake   - deterministic, no model, no torch (tests and dry runs)
+  model  - the incumbent model itself (base + current adapter), i.e. SEAL's
+           inner loop without the RL outer loop
+
+Leakage rule: a generator only ever sees documents of the training window.
+`build_training_set` refuses source documents whose id is in the test window.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from dataclasses import asdict, replace
+from pathlib import Path
+from typing import Protocol
+
+from .data import Doc
+
+MODES = ("raw", "self", "self+raw")
+
+# SEAL's knowledge-incorporation prompt asks for "implications" of a passage
+# (Zweiger et al. 2025, arXiv:2506.10943). A 135M base model is not instruction
+# tuned, so the prompt is a plain-text continuation with a fixed format.
+PROMPTS = {
+    "implications": "Title: {title}\nAbstract: {abstract}\n\nImplications of this paper:\n1.",
+    "restate": "Title: {title}\nAbstract: {abstract}\n\nThe same paper, explained in other words:\n",
+    "qa": "Title: {title}\nAbstract: {abstract}\n\nQuestions and answers about this paper:\nQ:",
+}
+
+
+class Generator(Protocol):
+    name: str
+
+    def generate(self, doc: Doc, n: int, seed: int) -> list[str]:
+        """Return up to n generated texts for `doc`."""
+
+
+_SENT = re.compile(r"(?<=[.!?])\s+(?=[A-Z0-9])")
+
+
+def sentences(text: str) -> list[str]:
+    return [s.strip() for s in _SENT.split(text) if s.strip()]
+
+
+class FakeGenerator:
+    """Deterministic stand-in: rotates and relabels the abstract's own sentences.
+
+    Output depends only on (doc, n, seed, style), never on a model, so tests are
+    exact. It is not meant to be a good self-edit, only a well-formed one.
+    """
+
+    def __init__(self, style: str = "implications"):
+        self.style = style
+        self.name = f"fake-{style}"
+
+    def generate(self, doc: Doc, n: int, seed: int) -> list[str]:
+        sents = sentences(doc.abstract) or [doc.abstract]
+        h = int(hashlib.sha256(f"{doc.id}|{seed}".encode()).hexdigest(), 16)
+        out = []
+        for k in range(n):
+            start = (h + k) % len(sents)
+            picked = sents[start:] + sents[:start]
+            body = " ".join(picked[: max(1, len(sents) // 2)])
+            out.append(f"{self.style.capitalize()} {k + 1}: {body}")
+        return out
+
+
+class ModelGenerator:
+    """The model writes its own training data (sampling from the incumbent).
+
+    `model` is the same object the loop is about to train; generation runs in
+    eval mode with no gradient, before training starts, so it is the incumbent
+    (base + current adapter) that writes the data.
+    """
+
+    def __init__(self, model, tok, style: str = "implications", max_new_tokens: int = 160,
+                 temperature: float = 0.7, top_p: float = 0.9, max_prompt_tokens: int = 384):
+        self.model, self.tok, self.style = model, tok, style
+        self.max_new_tokens, self.temperature, self.top_p = max_new_tokens, temperature, top_p
+        self.max_prompt_tokens = max_prompt_tokens
+        self.name = f"model-{style}"
+
+    def generate(self, doc: Doc, n: int, seed: int) -> list[str]:
+        import torch  # local import: the rest of this module needs no torch
+
+        prompt = PROMPTS[self.style].format(title=doc.title, abstract=doc.abstract)
+        ids = self.tok(prompt, return_tensors="pt", add_special_tokens=False).input_ids
+        ids = ids[:, -self.max_prompt_tokens:]
+        if self.tok.bos_token_id is not None:
+            ids = torch.cat([torch.tensor([[self.tok.bos_token_id]]), ids], 1)
+        was_training = self.model.training
+        self.model.eval()
+        torch.manual_seed(seed)
+        with torch.no_grad():
+            out = self.model.generate(
+                input_ids=ids.repeat(n, 1), attention_mask=torch.ones_like(ids).repeat(n, 1),
+                do_sample=True, temperature=self.temperature, top_p=self.top_p,
+                max_new_tokens=self.max_new_tokens, pad_token_id=self.tok.pad_token_id)
+        if was_training:
+            self.model.train()
+        return [self.tok.decode(o[ids.shape[1]:], skip_special_tokens=True) for o in out]
+
+
+def clean(text: str, min_chars: int = 40) -> str | None:
+    """Keep the first block of generated text; drop it if too short or a copy of the prompt."""
+    text = text.split("\n\n")[0]
+    text = re.sub(r"\s+", " ", text).strip()
+    if len(text) < min_chars or text.lower().startswith(("title:", "abstract:")):
+        return None
+    return text
+
+
+def self_edit_docs(doc: Doc, gen: Generator, n: int, seed: int) -> list[Doc]:
+    """Turn one source document into up to n training Docs, with provenance."""
+    out, seen = [], set()
+    for k, raw in enumerate(gen.generate(doc, n, seed)):
+        text = clean(raw)
+        if text is None or text in seen or text == doc.abstract:
+            continue
+        seen.add(text)
+        out.append(replace(doc, id=f"{doc.id}#se{k}", abstract=text,
+                           categories=doc.categories + (f"self-edit:{gen.name}",)))
+    return out
+
+
+def build_training_set(mode: str, chosen: list[Doc], gen: Generator | None, n: int, seed: int,
+                       test_ids: set[str] = frozenset()) -> list[Doc]:
+    """The documents the adapter trains on this cycle (before replay and anchor)."""
+    if mode not in MODES:
+        raise ValueError(mode)
+    leaked = [d.id for d in chosen if d.id in test_ids]
+    if leaked:
+        raise ValueError(f"self-edit source documents from the test window: {leaked[:5]}")
+    if mode == "raw":
+        return list(chosen)
+    if gen is None:
+        raise ValueError("self-edit mode needs a generator")
+    edits = [e for i, d in enumerate(chosen) for e in self_edit_docs(d, gen, n, seed * 100003 + i)]
+    return edits if mode == "self" else list(chosen) + edits
+
+
+def save_edits(path: Path, docs: list[Doc]) -> None:
+    """Every self-generated text is kept on disk so it can be audited or removed."""
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("w") as f:
+        for d in docs:
+            f.write(json.dumps(asdict(d), ensure_ascii=False) + "\n")
diff -ruN '--exclude=__pycache__' a/selfloop/tests/test_loop_wiring.py selfloop/tests/test_loop_wiring.py
--- a/selfloop/tests/test_loop_wiring.py	1970-01-01 00:00:00.000000000 +0000
+++ b/selfloop/tests/test_loop_wiring.py	2026-11-23 00:03:25.873498034 +0000
@@ -0,0 +1,126 @@
+"""End-to-end wiring of loop.main with a fake model and a fake generator.
+
+torch, transformers and peft are replaced by stubs, so this runs anywhere. It
+checks what the loop feeds to train() in each mode and that the decision still
+comes from the unchanged stats.gate; it says nothing about real model quality.
+"""
+import hashlib
+import importlib
+import json
+import sys
+import types
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from selfloop.data import Doc, save_jsonl
+
+ABS = ("We study {k} for small models. Our method adds a cache. "
+       "It reduces latency by a margin. Results hold on three benchmarks.")
+
+
+class FakeModel:
+    def __init__(self, skill=0.0):
+        self.skill, self.training = skill, False
+
+    def save_pretrained(self, path):
+        Path(path).mkdir(parents=True, exist_ok=True)
+        (Path(path) / "skill").write_text(str(self.skill))
+
+
+def install_stubs(monkeypatch, calls):
+    torch = types.ModuleType("torch")
+    torch.manual_seed = lambda s: None
+    model = types.ModuleType("selfloop.model")
+    model.load_tokenizer = lambda name: object()
+    model.load_model = lambda name, adapter=None, trainable=False: \
+        FakeModel(float((Path(adapter) / "skill").read_text()) if adapter else 0.0)
+    model.new_adapter = lambda m: m
+
+    def score(m, tok, docs, index=None):
+        ntok = np.full(len(docs), 100.0)
+        noise = np.array([int(hashlib.sha256(d.id.encode()).hexdigest(), 16) % 7 for d in docs])
+        fresh = np.array([0.0 if d.id.startswith("core") else m.skill for d in docs])
+        return ntok * (5.0 - fresh) + noise - (5.0 if index else 0.0), ntok
+
+    def train(m, tok, docs, epochs, lr, seed):
+        calls.append([d.id for d in docs])
+        m.skill += 0.002 * len(docs)
+        return 1.0
+
+    model.score, model.train = score, train
+    monkeypatch.setitem(sys.modules, "torch", torch)
+    monkeypatch.setitem(sys.modules, "selfloop.model", model)
+    monkeypatch.delitem(sys.modules, "selfloop.loop", raising=False)
+    return importlib.import_module("selfloop.loop")
+
+
+def make_data(d: Path):
+    def docs(prefix, n):
+        return [Doc(f"{prefix}{i}", f"title {prefix}{i}", ABS.format(k=prefix), "", ("cs.CL",), "")
+                for i in range(n)]
+    for w in range(3):
+        save_jsonl(d / f"window_{w}.jsonl", docs(f"w{w}-", 40))
+    save_jsonl(d / "core_domain_old.jsonl", docs("core-d", 30))
+    save_jsonl(d / "core_general.jsonl", docs("core-g", 30))
+    save_jsonl(d / "anchor_general.jsonl", docs("anc", 60))
+
+
+@pytest.mark.parametrize("mode", ["raw", "self", "self+raw"])
+def test_loop_modes(monkeypatch, tmp_path, mode):
+    calls = []
+    loop = install_stubs(monkeypatch, calls)
+    make_data(tmp_path / "data")
+    out = tmp_path / "out"
+    monkeypatch.setattr(sys, "argv", ["loop", "--data", str(tmp_path / "data"), "--out", str(out),
+                                      "--anchor", "0.5", "--train-on", mode, "--generator", "fake"])
+    loop.main()
+    log = json.loads((out / "log.json").read_text())
+    assert len(log) == 2 and all(r["train_on"] == mode for r in log)
+    first = calls[0]
+    src = [i for i in first if i.startswith("w0-") and "#" not in i]
+    edits = [i for i in first if "#se" in i]
+    anchors = [i for i in first if i.startswith("anc")]
+    assert len(anchors) == 20                      # anchor follows source docs, as in stage 0b
+    if mode == "raw":
+        assert len(src) == 40 and not edits
+        assert not (out / "selfedits_0.jsonl").exists()
+    elif mode == "self":
+        assert not src and len(edits) == 80        # no raw document reaches the weights
+        assert (out / "selfedits_0.jsonl").exists()
+    else:
+        assert len(src) == 40 and len(edits) == 80
+    # nothing from the window being tested is ever trained on in the same cycle
+    assert not any(i.split("#")[0].startswith("w1-") for i in first)
+    # replay in cycle 1 is drawn from what cycle 0 trained on (edits in self mode)
+    replay = [i for i in calls[1] if i.startswith("w0-")]
+    assert len(replay) == 20
+    if mode == "self":
+        assert all("#se" in i for i in replay)
+    for r in log:
+        assert set(r["decision"]) == {"accept", "reasons"}
+        assert r["decision"]["accept"] == (r["candidate_vs_incumbent"]["hi"] < 0 and not r["decision"]["reasons"])
+
+
+def test_cycles_flag(monkeypatch, tmp_path):
+    calls = []
+    loop = install_stubs(monkeypatch, calls)
+    make_data(tmp_path / "data")
+    monkeypatch.setattr(sys, "argv", ["loop", "--data", str(tmp_path / "data"), "--out",
+                                      str(tmp_path / "o"), "--cycles", "1"])
+    loop.main()
+    assert len(json.loads((tmp_path / "o" / "log.json").read_text())) == 1
+
+
+def test_compare_two_runs(monkeypatch, tmp_path):
+    loop = install_stubs(monkeypatch, [])
+    make_data(tmp_path / "data")
+    for mode in ("raw", "self+raw"):
+        monkeypatch.setattr(sys, "argv", ["loop", "--data", str(tmp_path / "data"), "--out",
+                                          str(tmp_path / mode), "--train-on", mode, "--generator", "fake"])
+        loop.main()
+    from selfloop.compare import compare
+    rows = compare(tmp_path / "self+raw", tmp_path / "raw")
+    assert [r["cycle"] for r in rows] == [0, 1]
+    assert rows[0]["A_vs_B"]["hi"] < 0     # the stub rewards more training items
