+    assert g.generate(doc(1), 3, 7) == g.generate(doc(1), 3, 7)
+    assert len(g.generate(doc(1), 3, 7)) == 3
+    outs = {tuple(g.generate(doc(1), 2, s)) for s in range(10)}
+    assert len(outs) > 1   # the seed matters
