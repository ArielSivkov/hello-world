+def test_on_real_window_files():
+    w0 = load_jsonl(ROOT / "data" / "window_0.jsonl")
+    w1 = load_jsonl(ROOT / "data" / "window_1.jsonl")
+    es = build_training_set("self", w0, FakeGenerator(), 2, 0, test_ids={d.id for d in w1})
